config_version=5

[application]
config/name="Hybrid Animation Studio"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.91,0.94,0.97,1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1400
window/size/viewport_height=900
window/size/window_width_override=1400
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
shader_compiler/shader_cache/enabled=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.045,0.065,1)
